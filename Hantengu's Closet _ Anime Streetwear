@charset "utf-8";

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body { margin: 0px; background: rgb(7, 7, 7); color: rgb(255, 255, 255); font-family: Arial, Helvetica, sans-serif; }

a { color: inherit; text-decoration: none; }

nav { position: sticky; top: 0px; z-index: 20; background: rgba(5, 5, 5, 0.94); backdrop-filter: blur(12px); border-bottom: 1px solid rgb(50, 16, 16); padding: 15px 6%; display: flex; align-items: center; justify-content: space-between; }

.logo { font-weight: 900; font-size: 1.35rem; letter-spacing: 1px; text-transform: uppercase; }

.logo span, .red { color: rgb(226, 27, 35); }

nav .links { display: flex; gap: 25px; font-size: 0.9rem; font-weight: 700; text-transform: uppercase; }

.order-nav { border: 1px solid rgb(226, 27, 35); padding: 10px 14px; border-radius: 8px; color: rgb(255, 51, 59); }

.hero { min-height: 620px; padding: 70px 7%; display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 35px; background: radial-gradient(circle at 80% 45%, rgba(185, 0, 0, 0.28), transparent 38%), linear-gradient(120deg, rgb(8, 8, 8), rgb(17, 17, 17) 55%, rgb(5, 5, 5)); }

.kicker { color: rgb(226, 27, 35); font-weight: 900; letter-spacing: 4px; text-transform: uppercase; }

.hero h1 { font-size: clamp(3.4rem, 8vw, 7rem); line-height: 0.85; margin: 18px 0px 25px; text-transform: uppercase; font-style: italic; }

.hero h1 span { color: rgb(226, 27, 35); }

.hero p { max-width: 560px; color: rgb(187, 187, 187); line-height: 1.7; font-size: 1.05rem; }

.cta { display: inline-flex; margin-top: 18px; padding: 16px 23px; border: 1px solid rgb(226, 27, 35); border-radius: 9px; background: rgb(169, 9, 16); font-weight: 900; text-transform: uppercase; box-shadow: rgba(226, 27, 35, 0.22) 0px 12px 35px; }

.hero-art { display: flex; justify-content: center; align-items: center; }

.hero-art img { width: min(100%, 620px); max-height: 510px; object-fit: cover; border-radius: 14px; box-shadow: rgba(0, 0, 0, 0.8) 0px 25px 80px; border: 1px solid rgb(53, 16, 16); }

.features { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid rgb(53, 16, 16); border-bottom: 1px solid rgb(53, 16, 16); background: rgb(11, 11, 11); }

.feature { padding: 25px; text-align: center; border-right: 1px solid rgb(42, 23, 23); }

.feature:last-child { border-right: 0px; }

.feature b { display: block; margin-bottom: 7px; }

.feature small { color: rgb(136, 136, 136); }

section { padding: 75px 6%; }

.section-title { text-align: center; margin-bottom: 40px; }

.section-title h2 { font-size: 2.5rem; margin: 0px 0px 10px; text-transform: uppercase; font-style: italic; }

.section-title p { color: rgb(136, 136, 136); margin: 0px; }

.grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; max-width: 1200px; margin: auto; }

.card { background: rgb(13, 13, 13); border: 1px solid rgb(48, 16, 16); border-radius: 14px; overflow: hidden; transition: 0.25s; }

.card:hover { transform: translateY(-5px); border-color: rgb(226, 27, 35); }

.card img { width: 100%; height: 360px; object-fit: cover; display: block; background: rgb(17, 17, 17); }

.card-info { padding: 18px; }

.card h3 { margin: 0px 0px 12px; font-size: 1.05rem; text-transform: uppercase; }

.order { display: block; text-align: center; border: 1px solid rgb(226, 27, 35); border-radius: 8px; padding: 11px; font-weight: 900; color: rgb(255, 51, 59); }

.order:hover { background: rgb(169, 9, 16); color: rgb(255, 255, 255); }

.about { background: rgb(11, 11, 11); text-align: center; border-top: 1px solid rgb(36, 16, 16); border-bottom: 1px solid rgb(36, 16, 16); }

.about p { max-width: 720px; margin: 15px auto; color: rgb(170, 170, 170); line-height: 1.8; }

.contact { text-align: center; background: linear-gradient(135deg, rgb(19, 6, 7), rgb(8, 8, 8)); }

.number { font-size: clamp(2rem, 6vw, 4rem); font-weight: 900; color: rgb(226, 27, 35); letter-spacing: 2px; margin: 20px 0px; }

footer { padding: 30px 6%; text-align: center; color: rgb(102, 102, 102); border-top: 1px solid rgb(36, 16, 16); }

@media (max-width: 850px) {
  nav .links { display: none; }
  .hero { grid-template-columns: 1fr; text-align: center; padding-top: 55px; }
  .hero p { margin-left: auto; margin-right: auto; }
  .features { grid-template-columns: 1fr 1fr; }
  .feature:nth-child(2) { border-right: 0px; }
  .feature:nth-child(-n+2) { border-bottom: 1px solid rgb(42, 23, 23); }
  .grid { grid-template-columns: 1fr 1fr; }
}

@media (max-width: 560px) {
  .grid { grid-template-columns: 1fr; }
  .card img { height: 390px; }
  .hero { min-height: auto; }
  .features { grid-template-columns: 1fr; }
  .feature { border-bottom: 1px solid rgb(42, 23, 23); border-right: 0px !important; }
  .feature:last-child { border-bottom: 0px; }
}
